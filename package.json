{
  "name": "ai-capcut-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AI-First Prompt Video Editor (9:16 Reel & 16:9 YouTube) — CapCut Web Studio powered by AI & GPU NVENC",
  "scripts": {
    "dev": "vite --port 5173 --host",
